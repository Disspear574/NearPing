// Copy to Signing.xcconfig and set your own Team ID. Signing.xcconfig is ignored by git.
//
// Without a Team ID the app is signed ad hoc: it runs on this Mac, but Keychain asks for
// the password after every rebuild. With a Team ID the signature is stable and one
// "Always Allow" is enough: uncomment the three lines at the bottom.

DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -

// DEVELOPMENT_TEAM = YOUR_TEAM_ID
// CODE_SIGN_STYLE = Automatic
// CODE_SIGN_IDENTITY = Apple Development
